generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DailyWeatherLog {
  id                  String   @id @default(cuid())
  city                String
  region              String?
  country             String
  countryCode         String?
  timezone            String?
  temperature         Float
  apparentTemperature Float?
  conditionText       String
  weatherCode         Int
  humidity            Int
  windSpeed           Float
  uvIndex             Float?
  surfacePressure     Float?
  sunrise             String?
  sunset              String?
  shortDescription    String?
  loggedAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([city, country])
  @@index([loggedAt])
}
